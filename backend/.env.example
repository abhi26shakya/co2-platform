# Backend environment - copy to .env
CO2_ENVIRONMENT=development
CO2_DATABASE_URL=postgresql+asyncpg://co2:co2password@localhost:5432/co2_platform
CO2_ML_SERVICE_URL=http://localhost:8001
CO2_INFERENCE_BACKEND=http
CO2_STORAGE_BACKEND=local
CO2_STORAGE_LOCAL_PATH=./storage
CO2_JWT_SECRET_KEY=change-me-in-production
CO2_CORS_ORIGINS=["http://localhost:3000"]
CO2_RATE_LIMIT_ENABLED=1
CO2_AUTH_RATE_LIMIT=30/minute
CO2_RATE_LIMIT_STORAGE=memory://   # redis://redis:6379/1 in production
CO2_FRONTEND_URL=http://localhost:3000

# Settings > Connected Accounts (Google OAuth). Leave unset to disable the
# connect flow - provision a client id/secret in Google Cloud Console first.
# CO2_GOOGLE_OAUTH_CLIENT_ID=
# CO2_GOOGLE_OAUTH_CLIENT_SECRET=
CO2_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# Settings > Notifications delivery. Disabled by default - sends are logged,
# not thrown, so local dev without SMTP creds still works.
CO2_SMTP_ENABLED=0
# CO2_SMTP_HOST=
# CO2_SMTP_PORT=587
# CO2_SMTP_USER=
# CO2_SMTP_PASSWORD=
# CO2_SMTP_FROM_ADDRESS=no-reply@emissia.dev

# OCO-3/GEE satellite data pipeline (Track A, docs/credentials-setup.md).
# Leave unset to disable - the batch job (scripts/run_oco3_batch.py) skips
# cleanly instead of crashing.
# CO2_GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# CO2_GEE_SERVICE_ACCOUNT_KEY_PATH=/run/secrets/gee-service-account.json
# CO2_GEE_PROJECT_ID=your-gcp-project-id
# CO2_NASA_EARTHDATA_USERNAME=
# CO2_NASA_EARTHDATA_PASSWORD=
