# ml-service environment - copy to .env
# See docs/credentials-setup.md for how to obtain these. Both are optional;
# the service runs fine without them - GEE/NASA-dependent inference paths
# just return a clean 503 (see app/core/errors.py) instead of a real result.

# CO2ML_GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# CO2ML_GEE_SERVICE_ACCOUNT_KEY_PATH=/run/secrets/gee-service-account.json
# CO2ML_GEE_PROJECT_ID=your-gcp-project-id

# CO2ML_NASA_EARTHDATA_USERNAME=
# CO2ML_NASA_EARTHDATA_PASSWORD=

CO2ML_BACKEND_INTERNAL_URL=http://localhost:8000
